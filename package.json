{
	"name": "@extws/server-bun",
	"version": "0.3.0-dev",
	"description": "ExtWS server for Bun",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"dependencies": {
		"@extws/server": "github:extws-team/server#a8dbccbe51a0b3e5626ce8758eb9875fb8ad141e"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "^0.4.1",
		"@types/bun": "1.4.0",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.15",
		"tsdown": "0.15.11",
		"typescript": "6.0.3",
		"unplugin-unused": "0.5.4"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --tsconfig tsconfig.main.json --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc -b",
		"test": "bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server-bun.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server-bun/issues"
	},
	"homepage": "https://github.com/extws-team/server-bun#readme"
}
