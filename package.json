{
	"name": "@extws/server-bun",
	"version": "0.3.0-dev",
	"description": "ExtWS server for Bun",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.mjs",
	"types": "dist/main.d.mts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"dependencies": {
		"@extws/server": "github:extws-team/server#9f694fe69d8474a97fb01813c41801a6ef9900d5"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.1",
		"@types/bun": "1.4.2",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"unplugin-unused": "0.6.0"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --tsconfig tsconfig.main.json --publint --unused --dts --format esm --format cjs",
		"check": "lint && bun run build && bun run test",
		"test": "bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server-bun.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server-bun/issues"
	},
	"homepage": "https://github.com/extws-team/server-bun#readme"
}
