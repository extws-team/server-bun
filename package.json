{
	"name": "@extws/server-bun",
	"version": "0.3.0-dev",
	"description": "ExtWS server for Bun",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"dependencies": {
		"@extws/server": "github:extws-team/server#d266a08a4cbf32270d2b0530f2a9504ec6c90bf6"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.1.1"
	},
	"devDependencies": {
		"@kirick/eslint-config": "0.1.30",
		"@types/bun": "^1.2.2",
		"eslint": "9.10.0",
		"publint": "0.3.12",
		"tsdown": "0.12.2",
		"typescript": "5.8.3",
		"unplugin-unused": "0.5.0",
		"vitest": "3.2.3"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "eslint . && tsc && (cd test && tsc)",
		"test": "bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server-bun.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server-bun/issues"
	},
	"homepage": "https://github.com/extws-team/server-bun#readme"
}
