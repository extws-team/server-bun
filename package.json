{
	"name": "@extws/server-bun",
	"version": "0.3.0-dev",
	"description": "ExtWS server for Bun",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist/"
	],
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"dependencies": {
		"@extws/server": "file:/tmp/devpack/github/@extws/server/pack-7a1f7fa.tar.gz"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.2",
		"@types/bun": "1.4.4",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"unplugin-unused": "0.6.0"
	},
	"_devpack": {
		"@extws/server": "../server"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --dts --format esm --format cjs --unused --publint --deps.never-bundle bun",
		"check": "lint && bun run test && bun run build",
		"test": "bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/server-bun.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/server-bun/issues"
	},
	"homepage": "https://github.com/extws-team/server-bun#readme"
}
